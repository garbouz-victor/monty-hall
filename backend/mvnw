#!/usr/bin/env sh
set -eu

MAVEN_VERSION="${MAVEN_VERSION:-3.9.9}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_DIR="$SCRIPT_DIR/.mvn/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_DIR/bin/mvn"
MAVEN_REPO="${MAVEN_REPO_LOCAL:-$SCRIPT_DIR/.mvn/repository}"
ARCHIVE="$SCRIPT_DIR/.mvn/apache-maven-$MAVEN_VERSION-bin.tar.gz"
URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"

if [ ! -x "$MAVEN_BIN" ]; then
  mkdir -p "$SCRIPT_DIR/.mvn"
  if [ ! -f "$ARCHIVE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$URL" -o "$ARCHIVE"
    elif command -v wget >/dev/null 2>&1; then
      wget -q "$URL" -O "$ARCHIVE"
    else
      echo "curl or wget is required to download Maven $MAVEN_VERSION" >&2
      exit 1
    fi
  fi
  tar -xzf "$ARCHIVE" -C "$SCRIPT_DIR/.mvn"
fi

cd "$SCRIPT_DIR"
exec "$MAVEN_BIN" -Dmaven.repo.local="$MAVEN_REPO" "$@"

